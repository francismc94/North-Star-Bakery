/* General styling */
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background-color: #FFF8F0;
    color: #2F2A26;
    font-family: Arial, sans-serif;
    line-height: 1.6;
}

h1, h2, h3 {
    font-family: Georgia, serif;
    color: #6B3E26;
}

header, nav, footer {
    padding: 20px;
}

nav {
    background-color: #6B3E26;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
}

nav a {
    color: white;
    text-decoration: none;
    font-weight: bold;
}

img, video {
    max-width: 100%;
    height: auto;
}

.featured-image,
.product-image {
    width: 100%;
    border-radius: 10px;
}

button {
    background-color: #D88C5A;
    color: #2F2A26;
    padding: 12px 20px;
    border: none;
    border-radius: 6px;
    cursor: pointer;
}

form {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

input, select, textarea {
    padding: 12px;
    border: 1px solid #6B3E26;
    border-radius: 5px;
    font: inherit;
}

/* Larger screens */
@media (min-width: 768px) {
    main {
        max-width: 1100px;
        margin: auto;
        padding: 30px;
    }

    .product-container {
        display: flex;
        flex-wrap: wrap;
        gap: 25px;
    }

    .product-card {
        flex: 1 1 250px;
    }

    nav {
        justify-content: center;
    }
}
